import socket
import os
import sys
sys.path.append(config['git_dir'])
from utils.utils import *
import pandas as pd
import json
import re

hostname = socket.gethostname()
curieNetwork = True

RES_FOLDER_INJECTION = config["output_dir"]
if config["analysis"] == "multipleInjections":
    RES_FOLDER_INJECTION = os.path.join(config["output_dir"], config["run"])

RES_FOLDER = os.path.join(config["output_dir"], config["run"])

LOG_PATH = os.path.join(RES_FOLDER, "logs/")
CONTAINERS_PATH = workflow.singularity_prefix

if "shbli" in hostname or "node" in hostname:
    LOG_CLUSTER_PATH=os.path.join(RES_FOLDER, "logs_cluster/")
    os.makedirs(LOG_CLUSTER_PATH, exist_ok=True)

concatFastq(config["output_dir"], config["run"], config["wildcards"]["injections"], config["wildcards"]["samples"], RES_FOLDER_INJECTION)


rule all:
    input:
        expand(os.path.join(RES_FOLDER_INJECTION, "{injections}", "{samples}", "FASTQ", "{samples}.fastq.gz"), injections = config["wildcards"]["injections"], samples = config["wildcards"]["samples"]),

rule basecalling:
    input:
        lambda wc: getFast5Dir(wc, fromBlow5 = config["fromBlow5"], extension = "fast5", onlyOnePath = True, config = config)
    output:
        fastq = expand(os.path.join(RES_FOLDER_INJECTION, "{{injections}}", "{samples}", "FASTQ", "{samples}.fastq.gz"), samples = config["wildcards"]["samples"]) 
    params:
        parameters_guppy = config["guppy"]["parameters_standalone"],
        parameters_dorado = config["dorado"]["parameters"],
        model_dorado = config["dorado"]["model"],
        parameters_dorado_demux = config["dorado"]["demux"],
        fromPod5 = config["fromPod5"],
        samples = config["wildcards"]["samples"],
        globalOutDir = RES_FOLDER_INJECTION
    log:
        os.path.join(LOG_PATH, "baseCalling/{injections}.log")
    threads: 1
    container:
        os.path.join(CONTAINERS_PATH, config["guppy"]["sif"]) if config["fromPod5"] == "no" else os.path.join(CONTAINERS_PATH, config["dorado"]["sif"])
    shell:
        """
        mkdir -p $(dirname {input})/fastq_pass
        if [ {params.fromPod5} == "yes" ]; then
            OUTPUT_FASTQ_FOLDER={params.globalOutDir}/{wildcards.injections}/FASTQ
            mkdir -p $OUTPUT_FASTQ_FOLDER
            dorado basecaller {params.parameters_dorado} {params.model_dorado} {input} > $OUTPUT_FASTQ_FOLDER/{wildcards.injections}.fastq 2> {log}
            dorado demux {params.parameters_dorado_demux} --output-dir {input}/fastq_pass $OUTPUT_FASTQ_FOLDER/{wildcards.injections}.fastq 2> {log}
        else
            /opt/ont-guppy/bin/guppy_basecaller {params.parameters_guppy} --input_path {input} --save_path {input}/fastq_pass 2> {log}
        fi
        for sample in {params.samples}
        do
            barcode=$(echo $sample | cut -d '_' -f 1)
            nb=${{barcode:2:2}}
            mkdir -p {params.globalOutDir}/{wildcards.injections}/$sample/FASTQ
            if [ {params.fromPod5} == "yes" ]; then
                mv {input}/fastq_pass/*_barcode$nb.fastq {params.globalOutDir}/{wildcards.injections}/$sample/FASTQ/$sample.fastq 2> {log}
                bgzip {params.globalOutDir}/{wildcards.injections}/$sample/FASTQ/$sample.fastq 2> {log}
            else
                cat {input}/fastq_pass/pass/barcode$nb/*.fastq.gz > {params.globalOutDir}/{wildcards.injections}/$sample/FASTQ/$sample.fastq.gz 2> {log}
            fi
        done       
        """
        
onstart:
    print("Launching NanoCliD analysis")
    if "email" in config.keys():
        sendMail(config, CONTAINERS_PATH, curieNetwork, "onstart")

onsuccess: 
    print("Demultiplexing completed successfully!")

onerror: 
    print("One or more errors occurred. Please refer to log file.")
    shell('echo {log} > log')
    logPath = subprocess.check_output("cat log && rm log", shell = True).decode("utf-8").rstrip()
    if "email" in config.keys():
        sendMail(config, CONTAINERS_PATH, curieNetwork, "onerror", logPath)
